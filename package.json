{
  "name": "zdress",
  "version": "1.0.0",
  "private": true,
  "description": "Root commands for the Zdress web app, API, and browser extension.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm run build:extension && npm run build:web",
    "build:extension": "npm --prefix apps/extension run build",
    "build:web": "npm --prefix apps/web run build",
    "lint": "npm run lint:web && npm run lint:firefox",
    "lint:web": "npm --prefix apps/web run lint",
    "lint:firefox": "npm --prefix apps/extension run lint:firefox",
    "package": "npm --prefix apps/extension run package",
    "start": "npm run start:api",
    "start:api": "npm --prefix apps/api run start",
    "start:web": "npm --prefix apps/web run start"
  }
}
