# YouCam / Perfect Corp API key — https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# OpenAI API key — used for the garment-detection pre-flight
OPENAI_API_KEY=

# Optional overrides
PORT=3000
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
OPENAI_MODEL=gpt-5.4-mini

# The stylist ("Expert opinion") runs on its own model: nothing is waiting on it,
# so it can afford more than the latency-tuned screening call. Defaults to the
# same mini model at higher effort; point it at a larger one for better advice.
OPENAI_STYLIST_MODEL=gpt-5.4-mini

# Experimental garment clean-up before rendering. Off by default: measured
# worse than the untouched original. See server/tools/stress-inputs.js
GARMENT_PREP=0
